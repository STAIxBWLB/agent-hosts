{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun"
    ],
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src",
    "test",
    "scripts"
  ]
}
